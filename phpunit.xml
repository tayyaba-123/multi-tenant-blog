<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://blogs.test"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Redis, not array: tenancy rebuilds the cache manager on every
             context switch, which would wipe an in-memory store and make
             cache isolation tests pass for the wrong reason. -->
        <env name="CACHE_STORE" value="redis"/>
        <env name="REDIS_CLIENT" value="predis"/>
        <env name="REDIS_CACHE_DB" value="15"/>
        <env name="CENTRAL_DOMAINS" value="blogs.test,localhost"/>
        <env name="TENANT_BASE_DOMAIN" value="blogs.test"/>
        <env name="TENANCY_DB_PREFIX" value="testing_tenant_"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="blogs_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
